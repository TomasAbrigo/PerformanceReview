# Copy to .env.local and fill in. Local values come from `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# `pnpm test:e2e` empties and reseeds its own database: this one, or by default
# DATABASE_URL with `_e2e` appended to the database name (created on first use).
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres_e2e

# Bamboo API (only for `pnpm ingest <entity> --source bamboo`)
BAMBOO_COMPANY_DOMAIN=
BAMBOO_API_KEY=

# Read-only JSON API and CSV exports (/api/v1). When set, requests need
# `Authorization: Bearer <API_TOKEN>`; when empty or unset the API is open (local dev).
API_TOKEN=

# File uploads (src/modules/lake/upload.ts). Defaults: var/uploads and var/profiles.
# UPLOADS_DIR=
# PROFILES_DIR=
