# Copy to .env.local and fill in. Local values come from `supabase status`.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres

# Reservado para Supabase Auth (v2), no se usa aún: la app no lee estas
# variables hoy (v1 no tiene login). Se dejan para no tener que agregarlas luego.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# `pnpm test:e2e` empties and reseeds its own database, never the one you develop
# on: E2E_DATABASE_URL, or by default DATABASE_URL with `_e2e` appended to the
# database name (e.g. `postgres_e2e`, created on first use; local hosts only).
# E2E_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres_e2e

# Port of the `next dev` server that Playwright starts. Default: 3100
# (3000 is left to `pnpm dev`).
# E2E_PORT=3100

# Bamboo API (only for `pnpm ingest <entity> --source bamboo`)
BAMBOO_COMPANY_DOMAIN=
BAMBOO_API_KEY=

# Read-only JSON API and CSV exports (/api/v1). When set, requests need
# `Authorization: Bearer <API_TOKEN>`; when empty or unset the API is open (local dev).
API_TOKEN=

# File uploads (src/modules/lake/upload.ts). Defaults: var/uploads and var/profiles.
# UPLOADS_DIR=
# PROFILES_DIR=

# Qualitative analysis (/insights/qualitative, pnpm analysis:run).
# mock (default, local heuristic) or anthropic (Claude API; needs ANTHROPIC_API_KEY).
ANALYSIS_PROVIDER=mock
ANTHROPIC_API_KEY=
# ANALYSIS_MODEL=claude-opus-5-5
